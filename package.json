{
  "name": "perler-beads",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify:ui-contract": "node scripts/verify-ui-contract.mjs",
    "check": "npm run typecheck && npm run lint && npm run verify:ui-contract && npm run build",
    "healthz": "node -e \"require('http').get('http://localhost:3000/api/healthz', r => { let d=''; r.on('data',c=>d+=c); r.on('end',()=>{ console.log(d); process.exit(r.statusCode===200?0:1); }); })\""
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "next": "15.3.6",
    "next-pwa": "^5.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.6",
    "sharp": "^0.34.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
